# Metabase instance the dashboard pulls from (base URL, no trailing slash)
METABASE_URL=https://metabase.example.com
# Metabase API key (Admin > Settings > Authentication > API keys); needs access to the Presto database
METABASE_API_KEY= # secret
# Path of Metabase's MCP endpoint on that host
METABASE_MCP_PATH=/api/mcp
# Comma-separated emails allowed to edit (upload, refresh, save). Blank = every signed-in user can edit.
EDITOR_EMAILS=
